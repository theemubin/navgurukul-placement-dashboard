PORT=5000
MONGODB_URI=mongodb://localhost:27017/placement_dashboard
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
NODE_ENV=development

# Redis Configuration
REDIS_ENABLED=true
# Development URL (Local Docker or redis-server)
REDIS_URL=redis://localhost:6379
# Cache duration Time-To-Live in seconds (e.g. 60 seconds = 1 minute)
# REDIS_CACHE_TTL=60 # Set to override all route cache times globally

# Category-Specific Caching TTLs (in seconds)
REDIS_TTL_DASHBOARD_STATS=60
REDIS_TTL_STUDENT_LIST=60
REDIS_TTL_JOB_LIST=120
REDIS_TTL_APPLICATION_COUNTS=60
REDIS_TTL_CAMPUS_LIST=1800
REDIS_TTL_JOB_READINESS=300
REDIS_TTL_STATIC_DATA=3600
REDIS_TTL_SEARCH_RESULTS=60

# Production URL (Upstash / Redis Cloud / Render)
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-instance.upstash.io:6379

# NavGurukul External API Integration
NAVGURUKUL_API_TOKEN=your_navgurukul_api_token_here

# Google AI API Key for Scam Detection and Job Parsing
# Get your key from: https://aistudio.google.com/app/apikey
# Make sure the key has access to Gemini models
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
